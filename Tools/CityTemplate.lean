import JsbExact.Model

/-! `citytemplate RUN K`: print record `K` of a `jsbx/harness.cpp` dump as a Lean `State Float` literal. -/

open JsbExact

def loadRun (pfx : String) : IO (Array String × FloatArray) := do
  let names := ((← IO.FS.readFile (pfx ++ ".names")).splitOn "\n").filter (· ≠ "") |>.toArray
  let bytes ← IO.FS.readBinFile (pfx ++ ".bin")
  let mut fa : FloatArray := FloatArray.emptyWithCapacity (bytes.size / 8)
  for i in [0:bytes.size / 8] do
    let mut u : UInt64 := 0
    for j in [0:8] do
      u := u ||| ((bytes[8 * i + j]!).toUInt64 <<< (8 * j).toUInt64)
    fa := fa.push (Float.ofBits u)
  return (names, fa)

def lit (x : Float) : String :=
  let h := (Nat.toDigits 16 x.toBits.toNat).asString
  s!"(Float.ofBits 0x{"".pushn (Char.ofNat 48) (16 - h.length)}{h})"

def main (args : List String) : IO Unit := do
  let (names, fa) ← loadRun (args.headD "ext/data/level")
  let k := (args.getD 1 "0").toNat!
  let g := fun (n : String) => lit fa[k * names.size + (names.idxOf? n).getD (panic! n)]!
  let v := fun (p : String) => s!"⟨{g (p ++ "1")}, {g (p ++ "2")}, {g (p ++ "3")}⟩"
  let b := fun (n : String) => if fa[k * names.size + (names.idxOf? n).get!]! != 0.0 then "true" else "false"
  let gear := fun (i : Nat) =>
    let p := s!"g{i}_"
    s!"\{ wow := {b (p ++ "wow")}, lm0 := {g (p ++ "lm0")}, lm1 := {g (p ++ "lm1")}, lm2 := {g (p ++ "lm2")}, " ++
    s!"slip := {g (p ++ "slip")}, steer := {g (p ++ "steer")}, act := {v (p ++ "act")}, " ++
    s!"mT := M33.mk' {g (p ++ "mT11")} {g (p ++ "mT12")} {g (p ++ "mT13")} {g (p ++ "mT21")} {g (p ++ "mT22")} " ++
    s!"{g (p ++ "mT23")} {g (p ++ "mT31")} {g (p ++ "mT32")} {g (p ++ "mT33")} }"
  IO.println "import JsbExact.Model\n\n/-! Generated by `citytemplate`: one in-flight c172p state from a JSBSim dump. -/\n"
  IO.println "namespace CityJsb\nopen JsbExact\n"
  IO.println "def template : State Float :="
  IO.println s!"  \{ q := ⟨{g "qi1"}, {g "qi2"}, {g "qi3"}, {g "qi4"}⟩,"
  IO.println s!"    qdot := ⟨{g "qdot1"}, {g "qdot2"}, {g "qdot3"}, {g "qdot4"}⟩,"
  IO.println s!"    pqri := {v "pqri"}, ri := {v "ri"}, vi := {v "vi"},"
  IO.println s!"    vih0 := {v "vih0_"}, vih1 := {v "vih1_"}, aih0 := {v "aih0_"}, epa := {g "epa"},"
  IO.println s!"    pqridot := {v "pqridot"}, uvwidot := {v "uvwidot"}, uvwdot := {v "uvwdot"}, stall := {g "stall"},"
  IO.println s!"    cg := {v "cg"}, tank0 := {g "tank0"}, tank1 := {g "tank1"}, tmap := {g "tmap"}, running := {b "running"},"
  IO.println s!"    fuelflow := {g "fuelflow"}, starved := {b "starved"}, rpm := {g "rpm"}, act := {v "actxyz"},"
  IO.println s!"    lastcg := {v "lastcg"}, wind := {v "d_wind"},"
  IO.println s!"    gears := #[{", ".intercalate ((List.range Gen.gears.size).map gear)}] }"
  IO.println "\nend CityJsb"
